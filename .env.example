# Copy this file to .env and fill in your own values.

# Required only for AI assessment. Scraping-only mode does not need an API key.
api_key=YOUR_OPENAI_API_KEY
model=gpt-4o-mini

# Job search settings.
search_term=software engineer
sites=indeed,linkedin,zip_recruiter,glassdoor
results_wanted=25
location=Tel Aviv-Yafo
hours_old=168

# JobSpy settings.
country_indeed=Israel
distance=25
linkedin_fetch_description=true
description_format=markdown
jobspy_verbose=1

# Optional JobSpy filters.
# job_type=fulltime
# is_remote=true
# easy_apply=true
# proxies=host:port,user:pass@host:port

# Optional: reuse an existing OpenAI assistant.
# assistant_id=asst_xxx
